{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["chrome", "dom-chromium-ai"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}